{
  "$schema": "../../docs/schemas/extension-manifest.schema.json",
  "id": "paheal",
  "name": "Rule34 Paheal",
  "abbr": "rp",
  "version": "1.0.4",
  "apiVersion": 1,
  "kind": "downloader",
  "default": false,
  "site": "https://rule34.paheal.net/",
  "media": [
    "image",
    "video"
  ],
  "entry": "downloader.py:DownloaderRp",
  "minSdkVersion": "1.1",
  "tagList": "rp_tags.json",
  "tagUpdate": {
    "entry": "tags.py:read_tags",
    "merge": {
      "minPosts": 100
    }
  },
  "description": "Shimmie danbooru-compatible API. Max 3 tags.",
  "syntax": {
    "concat": " ",
    "idSep": "=",
    "maxTagsStringLen": 300,
    "maxTags": 3,
    "metaCount": "(?:[<>]=?|=)[a-z\\d\\-_]+?",
    "sort": "order=(?:id|score)_desc",
    "fav": "favorited_by=[^:=]+?",
    "pool": ""
  }
}
