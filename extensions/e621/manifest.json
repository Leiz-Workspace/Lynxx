{
  "$schema": "../../docs/schemas/extension-manifest.schema.json",
  "id": "e621",
  "name": "e621",
  "abbr": "en",
  "version": "1.0.4",
  "apiVersion": 1,
  "kind": "downloader",
  "default": false,
  "site": "https://e621.net/",
  "media": [
    "image",
    "video"
  ],
  "entry": "downloader.py:DownloaderEn",
  "tagList": "en_tags.json",
  "description": "e621 JSON API (2 requests/second). Max 40 tags, 1 wildcard.",
  "syntax": {
    "concat": "+",
    "idSep": ":",
    "maxTagsStringLen": 3300,
    "maxTags": 40,
    "maxWildcards": 1,
    "metaCount": ":(?:[<>]=?|!)?[a-z\\d\\-_.]+?",
    "sort": "order:[^:]+(?:_(?:a|de)sc)?",
    "fav": "favorited_by:(?:!\\d+?|[^!][^:]+?)",
    "pool": "(?:pool|set):[^:]+?"
  }
}
