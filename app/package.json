{
  "name": "lynxx-desktop",
  "productName": "Lynxx",
  "desktopName": "lynxx.desktop",
  "version": "1.0.2",
  "description": "Lynxx desktop: download, read and export comics, novels and books (vBook-format extensions, local EPUB/PDF/MOBI/…)",
  "homepage": "https://github.com/Leiz-Workspace/Lynxx",
  "author": "Lynxx contributors",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging --lynxx-devtools",
    "check": "node test/syntax-check.js && node test/icon-utils.test.js && node test/plugin-runtime.test.js && node test/book-jobs.test.js",
    "check:core": "node -e \"if (!require('fs').existsSync('build/core/lynxx-core')) { console.error('frozen core missing: run python tools/build_core.py in the repo root first'); process.exit(1); }\"",
    "dist": "npm run check:core && electron-builder --publish never",
    "dist:dir": "npm run check:core && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "app.lynxx.desktop",
    "productName": "Lynxx",
    "copyright": "MIT License, Lynxx contributors (based on the original work of trickerer01)",
    "artifactName": "lynxx-${os}-${arch}_v${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon-utils.js",
      "package.json",
      "plugin/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "build/core/lynxx-core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "build/after-pack.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "lynxx",
      "syncDesktopName": true,
      "icon": "assets/icons/exposed-jaw-cyan.png",
      "category": "Office",
      "synopsis": "Comic, novel and book downloader and reader",
      "description": "Download comics and novels with vBook-format extensions, read EPUB/PDF/MOBI/CBZ/DOCX and more, export EPUB/KEPUB/CBZ/PDF",
      "executableArgs": [],
      "maintainer": "DungeonLeiz <korosakiryukai@gmail.com>",
      "vendor": "DungeonLeiz"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/exposed-jaw-cyan.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lynxx",
      "artifactName": "lynxx-setup-${arch}_v${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/exposed-jaw-cyan.png",
      "identity": null
    },
    "deb": {
      "packageCategory": "text"
    },
    "publish": null
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
