# Auto detect text files and perform LF normalization
* text=auto


# Whitespace rules
# strict (no trailing, no tabs)
*.py            whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol eol=lf
*.toml          whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol eol=lf
*.gitignore     whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol eol=lf
*.editorconfig  whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol eol=lf
*.gitattributes whitespace=trailing-space,space-before-tab,tab-in-indent,cr-at-eol eol=lf

# normal (no trailing)
*.txt           whitespace=trailing-space,space-before-tab,cr-at-eol

# special files which must ignore whitespace
*.patch         whitespace=-trailing-space eol=lf
*.diff          whitespace=-trailing-space eol=lf

# recorded pages of the tests: byte for byte on every system (their sha256 is checked), never CRLF on Windows; the site's
# trailing spaces are kept, so no whitespace check
lynxx/tests/fixtures/** -text -whitespace
