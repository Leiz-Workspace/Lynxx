{
  "$schema": "../../../docs/schemas/extension-manifest.schema.json",
  "id": "danbooru",
  "name": "Danbooru",
  "abbr": "db",
  "version": "1.1.0",
  "apiVersion": 1,
  "kind": "downloader",
  "default": true,
  "site": "https://danbooru.donmai.us/",
  "media": [
    "image",
    "video"
  ],
  "entry": "lynxx.download_db:DownloaderDb",
  "tagList": "db_tags.json",
  "description": "Danbooru JSON API. Anonymous search is limited to 2 tags: extra tags are checked locally.",
  "auth": {
    "apiKey": true,
    "apiKeyFormat": "API_KEY,LOGIN",
    "cookies": []
  },
  "syntax": {
    "concat": "+",
    "idSep": ":",
    "maxTagsStringLen": 3300,
    "maxTags": 2,
    "maxTagsSeparate": false,
    "maxWildcards": 0,
    "freeMetaPrefixes": [
      "rating:",
      "id:",
      "date:",
      "score:",
      "status:",
      "parent:"
    ],
    "localPositiveOverflow": true,
    "metaCount": ":(?:[<>]=?|!)?[a-z\\d\\-_.,]+?",
    "sort": "order:[a-z_]+",
    "fav": "favorited_by:[^:]+?",
    "pool": "pool:[^:]+?"
  },
  "search": {
    "kinds": [
      {
        "id": "uploader",
        "token": "user:",
        "value": "[^\\s:]+",
        "input": "text"
      },
      {
        "id": "favorites",
        "use": "fav",
        "input": "text"
      },
      {
        "id": "pool",
        "use": "pool",
        "input": "text",
        "example": "12345"
      }
    ],
    "metaNames": [
      "favgroup",
      "ordfavgroup"
    ]
  }
}
